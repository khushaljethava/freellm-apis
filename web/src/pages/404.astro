---
import Base from '../layouts/Base.astro';
---
<Base
  altLocales={[]}
  noindex
  title="Page Not Found | freellm.site"
  description="The page you are looking for does not exist."
>
  <div class="prose mx-auto max-w-3xl py-4 dark:prose-invert prose-headings:tracking-tight prose-a:text-primary text-center pt-16">
    <h1>404</h1>
    <p class="lead">This page doesn't exist.</p>
    <p>
      <a href="/">Browse free LLM APIs</a>
      · <a href="/blog/">Blog</a>
      · <a href="/models/">Models</a>
    </p>
  </div>
</Base>
