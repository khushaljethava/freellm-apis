---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { localePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { postPaths, postsFor, localesForPost } from '../../../i18n/posts';
import { renderPost } from '../../../lib/markdown';
import Badge from '../../../components/ui/Badge.astro';

export const getStaticPaths = postPaths;

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const L = (p: string) => localePath(p, locale);
// Posts in this language only — related links must never cross languages.
const posts = postsFor(locale);
// hreflang for this post covers only the languages it was actually translated into.
const altLocales = localesForPost(post.slug);

const { html: htmlContent, headings } = await renderPost(post.content, locale);

const modified = post.lastUpdated ?? post.date;
const blogPosting = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: modified,
  // A named person is the E-E-A-T signal; an org byline is not.
  author: {
    '@type': 'Person',
    '@id': 'https://www.freellm.site/#maintainer',
    name: 'Khushal Jethava',
    url: 'https://github.com/khushaljethava',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://www.freellm.site/#organization',
    name: 'freellm.site',
    url: 'https://www.freellm.site/',
    logo: 'https://www.freellm.site/logo.png',
  },
  image: 'https://www.freellm.site/og-default.png',
  keywords: post.tags.join(', '),
  inLanguage: locale,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://www.freellm.site${L(`/blog/${post.slug}/`)}`,
  },
};
const graph: object[] = [blogPosting];
if (post.faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: post.faq.map((f: { q: string; a: string }) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };

// Related posts: most tag overlap first, then newest. Top 3.
const related = posts
  .filter(p => p.slug !== post.slug)
  .map(p => ({ p, overlap: p.tags.filter(t => post.tags.includes(t)).length }))
  .sort((a, b) => b.overlap - a.overlap || b.p.date.localeCompare(a.p.date))
  .slice(0, 3)
  .map(x => x.p);
---
<Base
  locale={locale}
  altLocales={altLocales}
  title={`${post.title} | freellm.site`}
  description={post.description}
  ogType="article"
  schema={schema}
>
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
    <ol class="flex items-center gap-1.5">
      <li><a class="text-muted-foreground hover:text-foreground" href={L('/')}>{t.provider.home}</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="text-muted-foreground hover:text-foreground" href={L('/blog/')}>{t.nav.blog}</a></li>
    </ol>
  </nav>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_14rem]">
    <article class="min-w-0">
      <header class="mb-8 border-b pb-8">
        <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{post.title}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{post.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
          <span>By <a href="https://github.com/khushaljethava" rel="author">Khushal Jethava</a></span>
          <time datetime={post.date}>{post.date}</time>
          {modified !== post.date && <span>{t.post.updated} <time datetime={modified}>{modified}</time></span>}
          <div class="flex flex-wrap gap-1.5">{post.tags.map(tag => <Badge>{tag}</Badge>)}</div>
        </div>
      </header>

      <AdSlot variant="top" />

      <div class="prose max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-primary prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-table:text-sm" set:html={htmlContent} />

      {post.faq?.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-4 text-2xl font-semibold tracking-tight">{t.post.faqTitle}</h2>
          <div class="divide-y rounded-lg border bg-card">
            {post.faq.map((f) => (
              <details class="group px-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
                  <h3 class="text-base">{f.q}</h3>
                  <span class="text-muted-foreground transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="pb-4 text-muted-foreground">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <AdSlot variant="bottom" />

      {related.length > 0 && (
        <aside class="mt-12 border-t pt-8">
          <h2 class="mb-4 text-xl font-semibold tracking-tight">{t.post.relatedTitle}</h2>
          <ul class="link-list">
            {related.map(r => (
              <li><a href={L(`/blog/${r.slug}/`)}>{r.title}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t pt-6">
        <a href={L('/blog/')} class="btn btn-outline">{t.post.backToBlog}</a>
        <a href={L('/')} class="btn btn-primary">{t.post.browseCta}</a>
      </div>
    </article>

    {headings.length >= 3 && (
      <aside class="hidden lg:block">
        <nav class="sticky top-20 text-sm" aria-label="Table of contents">
          <ul class="space-y-2 border-s ps-4">
            {headings.map(h => (
              <li><a class="text-muted-foreground no-underline hover:text-foreground" href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Base>
