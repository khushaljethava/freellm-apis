---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { localeOf, localePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { postsFor, blogIndexPaths } from '../../../i18n/posts';
import Badge from '../../../components/ui/Badge.astro';

export const getStaticPaths = blogIndexPaths;

const locale = localeOf(Astro.params.lang);
const { blogLocales } = Astro.props;
const t = useTranslations(locale);
// Only list posts that actually exist in this language.
const sorted = [...postsFor(locale)].sort((a, b) => b.date.localeCompare(a.date));
---
<Base
  locale={locale}
  altLocales={blogLocales}
  title={t.blogIndex.title}
  description={t.blogIndex.description}
>
  <header class="py-6 sm:py-10">
    <h1 class="text-4xl font-bold tracking-tight">{t.blogIndex.h1}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{t.blogIndex.lede}</p>
  </header>

  <AdSlot variant="top" />

  <div class="grid gap-4 md:grid-cols-2">
    {sorted.map(post => (
      <article class="group relative flex flex-col rounded-xl border bg-card p-5 transition-colors hover:border-primary/40">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          <time datetime={post.date}>{post.date}</time>
          {post.tags.slice(0, 3).map(tag => <Badge>{tag}</Badge>)}
        </div>
        <h2 class="text-lg font-semibold leading-snug tracking-tight">
          <a class="text-foreground no-underline after:absolute after:inset-0 hover:no-underline group-hover:text-primary" href={localePath(`/blog/${post.slug}/`, locale)}>{post.title}</a>
        </h2>
        <p class="mt-2 flex-1 text-sm text-muted-foreground">{post.description}</p>
        <span class="mt-4 text-sm font-medium text-primary" aria-hidden="true">{t.common.readMore}</span>
      </article>
    ))}
  </div>

  <AdSlot variant="bottom" />
</Base>
