---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import providers from '../../../../../data/providers.json';
import models from '../../../../../data/models.json';
import { DEFAULT_LOCALE, localePath } from '../../../i18n/config';
import { TRANSLATED_LOCALES, useTranslations } from '../../../i18n/ui';
import { postsFor } from '../../../i18n/posts';

export function getStaticPaths() {
  // Curated high-demand pairs only (quality gate: no N×N thin pages).
  const PAIRS = [
    ['groq', 'google_gemini'], ['groq', 'cerebras'], ['groq', 'sambanova'],
    ['cerebras', 'sambanova'], ['mistral', 'groq'], ['google_gemini', 'mistral'],
    ['github_models', 'groq'], ['together_ai', 'groq'], ['openrouter', 'groq'],
    ['cohere', 'mistral'],
  ];
  const ids = Object.fromEntries(providers.map(p => [p.id, p]));
  return TRANSLATED_LOCALES.flatMap(locale =>
    PAIRS
      .filter(([x, y]) => ids[x] && ids[y])
      .map(([x, y]) => ({
        params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, pair: `${x}-vs-${y}` },
        props: { a: ids[x], b: ids[y], locale },
      }))
  );
}

const { a, b, locale } = Astro.props;
const t = useTranslations(locale);
const tc = t.compare;
const L = (p: string) => localePath(p, locale);
const G = (p: string) => localePath(p, postsFor(locale).length ? locale : DEFAULT_LOCALE);

const modelsOf = id => models.filter(m => m.provider_id === id && !m.deprecated);
const maxCtx = id => { const c = modelsOf(id).map(m => m.context_window); return c.length ? Math.max(...c) : 0; };
const maxRpm = id => { const r = modelsOf(id).map(m => m.rpm).filter(Boolean); return r.length ? Math.max(...r) : null; };
const fmtCtx = c => c >= 1_000_000 ? `${Math.round(c / 1_000_000)}M` : c ? `${Math.round(c / 1_000)}K` : '—';
const cardLabel = t.common.cardLabel;

const freeTypeLabel = p => p.free_type === 'permanent' ? tc.rows.permanent : tc.rows.credits;
const rpmLabel = id => maxRpm(id) != null ? String(maxRpm(id)) : tc.rows.seePage;
const rows = [
  [tc.rows.card, cardLabel[a.credit_card_required], cardLabel[b.credit_card_required]],
  [tc.rows.freeType, freeTypeLabel(a), freeTypeLabel(b)],
  [tc.rows.freeModels, String(modelsOf(a.id).length), String(modelsOf(b.id).length)],
  [tc.rows.maxContext, fmtCtx(maxCtx(a.id)), fmtCtx(maxCtx(b.id))],
  [tc.rows.maxRpm, rpmLabel(a.id), rpmLabel(b.id)],
  [tc.rows.baseUrl, a.base_url, b.base_url],
];

const verdictBits = [];
if (a.credit_card_required === 'no' && b.credit_card_required !== 'no') verdictBits.push(tc.verdictCard(a.name, b.name, cardLabel[b.credit_card_required].toLowerCase()));
else if (b.credit_card_required === 'no' && a.credit_card_required !== 'no') verdictBits.push(tc.verdictCard(b.name, a.name, cardLabel[a.credit_card_required].toLowerCase()));
if (maxCtx(a.id) > maxCtx(b.id) * 2) verdictBits.push(tc.verdictCtx(a.name, fmtCtx(maxCtx(a.id)), fmtCtx(maxCtx(b.id))));
else if (maxCtx(b.id) > maxCtx(a.id) * 2) verdictBits.push(tc.verdictCtx(b.name, fmtCtx(maxCtx(b.id)), fmtCtx(maxCtx(a.id))));
const verdict = verdictBits.length ? verdictBits.join(' ') : tc.verdictTie(a.name, b.name);

const pageUrl = `https://www.freellm.site${L(`/compare/${a.id}-vs-${b.id}/`)}`;
const title = tc.title(a.name, b.name);
const description = tc.description(a.name, b.name);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.provider.home, item: `https://www.freellm.site${L('/')}` },
        { '@type': 'ListItem', position: 2, name: tc.crumb(a.name, b.name), item: pageUrl },
      ],
    },
    {
      '@type': 'WebPage',
      name: title,
      url: pageUrl,
      description,
      inLanguage: locale,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.provider.h1(a.name), url: `https://www.freellm.site${L(`/providers/${a.id}/`)}` },
          { '@type': 'ListItem', position: 2, name: t.provider.h1(b.name), url: `https://www.freellm.site${L(`/providers/${b.id}/`)}` },
        ],
      },
    },
  ],
};
---
<Base
  locale={locale}
  altLocales={TRANSLATED_LOCALES}
  title={`${title} | freellm.site`}
  description={description}
  schema={schema}
>
  <div class="breadcrumb">
    <a href={L('/')}>{t.provider.home}</a><span>›</span><span>{tc.crumb(a.name, b.name)}</span>
  </div>

  <h1 style="font-size:1.8rem;font-weight:800;margin-bottom:1rem">{tc.h1(a.name, b.name)}</h1>

  <p style="color:#374151;line-height:1.6;margin-bottom:1.25rem">
    {tc.introA}<a href={L(`/providers/${a.id}/`)}>{a.name}</a>{tc.introAnd}<a
      href={L(`/providers/${b.id}/`)}>{b.name}</a>{tc.introEnd}
  </p>

  <AdSlot variant="top" />

  <h2 class="section-title">{tc.glanceTitle(a.name, b.name)}</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th></th><th>{a.name}</th><th>{b.name}</th></tr></thead>
      <tbody>
        {rows.map(([label, av, bv]) => (
          <tr><td><strong>{label}</strong></td><td>{av}</td><td>{bv}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section-title">{tc.pickTitle}</h2>
  <p style="color:#374151;line-height:1.6">{verdict}</p>
  <p style="color:#374151;line-height:1.6">
    {tc.bothCompatA}<a href={G('/blog/openai-compatible-free-llm-apis-list/')}>{tc.bothCompatLink1}</a
    >{tc.bothCompatMid}<a href={G('/blog/free-llm-api-rate-limits-compared/')}>{tc.bothCompatLink2}</a
    >{tc.bothCompatEnd}
  </p>

  <h2 class="section-title">{tc.detailsTitle}</h2>
  <ul class="related-links">
    <li><a href={L(`/providers/${a.id}/`)}>{tc.detailsItem(a.name)}</a></li>
    <li><a href={L(`/providers/${b.id}/`)}>{tc.detailsItem(b.name)}</a></li>
    <li><a href={L('/')}>{tc.browseAll}</a></li>
  </ul>

  <AdSlot variant="bottom" />
</Base>
