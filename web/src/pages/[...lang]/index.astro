---
import Base from '../../layouts/Base.astro';
import enPosts from '../../../../data/blog.json';
import FilterBar from '../../components/FilterBar.astro';
import AdSlot from '../../components/AdSlot.astro';
import providers from '../../../../data/providers.json';
import models from '../../../../data/models.json';
import { localeOf, localePath } from '../../i18n/config';
import { translatedPaths, useTranslations, TRANSLATED_LOCALES } from '../../i18n/ui';
import { postIn, postHref } from '../../i18n/posts';
import Badge from '../../components/ui/Badge.astro';
import { fmtCtx, CARD_VARIANT } from '../../lib/format';

export const getStaticPaths = translatedPaths;

const locale = localeOf(Astro.params.lang);
const t = useTranslations(locale);
const L = (p: string) => localePath(p, locale);

// Guides: prefer this language's version of each post, fall back to English per post.
const guides = enPosts.map(p => postIn(locale, p.slug) ?? p);
// Blog links resolve per post, so they never point at a page that wasn't built.
const G = (slug: string) => postHref(locale, slug);

const modelCount = (id) => models.filter(m => m.provider_id === id && !m.deprecated).length;
const maxContext = (id) => {
  const ctxs = models.filter(m => m.provider_id === id && !m.deprecated).map(m => m.context_window);
  return fmtCtx(ctxs.length ? Math.max(...ctxs) : 0);
};
const cardLabel = t.common.cardLabel;

const permanent = providers.filter(p => p.free_type === 'permanent').sort((a,b) => modelCount(b.id) - modelCount(a.id));
const credits = providers.filter(p => p.free_type === 'credits').sort((a,b) => (b.credit_amount_usd||0) - (a.credit_amount_usd||0));
const totalModels = models.filter(m => !m.deprecated).length;
const lastVerified = providers[0]?.last_verified ?? '';

const quickPick = permanent.find(p => p.credit_card_required === 'no');
const quickPickCtx = quickPick ? maxContext(quickPick.id) : null;
const quickPickModels = quickPick ? modelCount(quickPick.id) : 0;

const faqs = t.home.faqs(providers.length, totalModels);
const homeUrl = new URL(L('/'), Astro.site ?? Astro.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'freellm.site',
      url: homeUrl,
      inLanguage: locale,
      description: `Directory of ${providers.length} free LLM API providers and ${totalModels} models.`,
    },
    {
      '@type': 'Organization',
      name: 'freellm.site',
      url: 'https://www.freellm.site/',
      logo: 'https://www.freellm.site/logo.png',
      sameAs: ['https://github.com/khushaljethava/freellm-apis'],
    },
    {
      '@type': 'FAQPage',
      inLanguage: locale,
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base
  locale={locale}
  altLocales={TRANSLATED_LOCALES}
  title={t.home.title(providers.length)}
  description={t.home.description(providers.length, totalModels)}
  schema={schema}
>
  <section class="relative pt-6 pb-10 sm:pt-12">
    <div class="pointer-events-none absolute inset-x-0 -top-10 -z-10 h-64 bg-[radial-gradient(ellipse_at_top,var(--accent),transparent_70%)]" aria-hidden="true"></div>
    <Badge variant="outline" class="mb-5 gap-1.5 rounded-full bg-background px-3 py-1"><span class="size-1.5 rounded-full bg-success"></span>{t.home.eyebrow(lastVerified)}</Badge>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">{t.home.h1a} <span class="text-primary">{t.home.h1b}</span></h1>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{t.home.lede(providers.length)}</p>
    <dl class="mt-8 grid max-w-lg grid-cols-3 gap-3">
      <div class="rounded-lg border bg-card p-4"><dt class="text-xs text-muted-foreground">{t.home.statProviders}</dt><dd class="text-2xl font-bold tracking-tight">{providers.length}</dd></div>
      <div class="rounded-lg border bg-card p-4"><dt class="text-xs text-muted-foreground">{t.home.statModels}</dt><dd class="text-2xl font-bold tracking-tight">{totalModels}</dd></div>
      <div class="rounded-lg border bg-card p-4"><dt class="text-xs text-muted-foreground">{t.home.statAlwaysFree}</dt><dd class="text-2xl font-bold tracking-tight">{permanent.length}</dd></div>
    </dl>
  </section>

  {quickPick && (
    <div class="mb-8 flex flex-col gap-3 rounded-xl border border-primary/30 bg-accent/50 p-4 sm:flex-row sm:items-center">
      <Badge variant="default" class="w-fit">{t.home.quickPick}</Badge>
      <p class="flex-1 text-sm">
        <a class="font-semibold" href={L(`/providers/${quickPick.id}/`)}>{quickPick.name}</a>
        <span class="text-muted-foreground"> {t.home.quickPickMeta(quickPickModels, quickPickCtx)}</span>
      </p>
      <a href={quickPick.signup_url} target="_blank" rel="noopener" class="btn btn-primary btn-sm w-fit">{t.home.quickPickCta}</a>
    </div>
  )}

  <AdSlot variant="top" />

  <FilterBar />

  <h2 class="section-title">{t.home.permanentTitle}</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t.common.provider}</th>
          <th scope="col">{t.common.models}</th>
          <th scope="col">{t.common.card}</th>
          <th scope="col">{t.common.maxContext}</th>
          <th scope="col">{t.common.lastVerified}</th>
          <th scope="col"><span class="sr-only">{t.common.getKey}</span></th>
        </tr>
      </thead>
      <tbody>
        {permanent.map(p => (
          <tr data-free-type="permanent" data-card-required={p.credit_card_required}>
            <td><a class="font-medium" href={L(`/providers/${p.id}/`)}>{p.name}</a></td>
            <td class="tabular-nums">{modelCount(p.id)}</td>
            <td><Badge variant={CARD_VARIANT[p.credit_card_required]}>{cardLabel[p.credit_card_required]}</Badge></td>
            <td class="tabular-nums">{maxContext(p.id)}</td>
            <td class="text-muted-foreground tabular-nums"><time datetime={p.last_verified}>{p.last_verified}</time></td>
            <td class="text-end"><a class="btn btn-outline btn-sm" href={p.signup_url} target="_blank" rel="noopener">{t.common.getKeyCta}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section-title">{t.home.creditsTitle}</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t.common.provider}</th>
          <th scope="col">{t.common.credits}</th>
          <th scope="col">{t.common.expiry}</th>
          <th scope="col">{t.common.card}</th>
          <th scope="col">{t.common.models}</th>
          <th scope="col">{t.common.lastVerified}</th>
          <th scope="col"><span class="sr-only">{t.common.getKey}</span></th>
        </tr>
      </thead>
      <tbody>
        {credits.map(p => (
          <tr data-free-type="credits" data-card-required={p.credit_card_required}>
            <td><a class="font-medium" href={L(`/providers/${p.id}/`)}>{p.name}</a></td>
            <td class="tabular-nums">{p.credit_amount_usd ? `$${p.credit_amount_usd}` : t.common.freeTier}</td>
            <td class="text-muted-foreground">{p.credit_expiry ?? '—'}</td>
            <td><Badge variant={CARD_VARIANT[p.credit_card_required]}>{cardLabel[p.credit_card_required]}</Badge></td>
            <td class="tabular-nums">{modelCount(p.id)}</td>
            <td class="text-muted-foreground tabular-nums"><time datetime={p.last_verified}>{p.last_verified}</time></td>
            <td class="text-end"><a class="btn btn-outline btn-sm" href={p.signup_url} target="_blank" rel="noopener">{t.common.getKeyCta}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <AdSlot variant="bottom" />

  <section class="prose mx-auto mt-16 max-w-3xl dark:prose-invert prose-headings:tracking-tight prose-a:text-primary">
    <h2>{t.home.seoTitle}</h2>
    <p>
      {t.home.seoP1(providers.length, totalModels)}
      <a href={G('openai-compatible-api-guide')}>{t.home.seoP1Link}</a>{t.home.seoP1End}
    </p>
    <p>
      {t.home.seoP2}
      <a href={G('best-free-llm-apis-2026')}>{t.home.seoP2Link1}</a>,{' '}
      <a href={G('best-open-source-llm-apis')}>{t.home.seoP2Link2}</a>,{' '}
      <a href={G('best-free-llm-apis-for-coding')}>{t.home.seoP2Link3}</a>.
    </p>

    <h2>{t.home.guidesTitle}</h2>
    <ul class="not-prose link-list">
      {guides.map(p => (
        <li><a href={G(p.slug)}>{p.title}</a></li>
      ))}
    </ul>

    <h2>{t.home.faqTitle}</h2>
    <div class="not-prose divide-y rounded-lg border bg-card">
      {faqs.map(f => (
        <details class="group px-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
            <h3 class="text-base">{f.q}</h3>
            <span class="text-muted-foreground transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="pb-4 text-muted-foreground">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
