---
import Base from '../../layouts/Base.astro';
import providers from '../../../../data/providers.json';
import models from '../../../../data/models.json';
import { localeOf, localePath } from '../../i18n/config';
import { translatedPaths, useTranslations, TRANSLATED_LOCALES } from '../../i18n/ui';
import { SITE_LAST_MODIFIED } from '../../lib/seo.mjs';

export const getStaticPaths = translatedPaths;

const locale = localeOf(Astro.params.lang);
const t = useTranslations(locale);
const ta = t.about;

const providerCount = providers.length;
const modelCount = models.filter(m => !m.deprecated).length;

const L = (path: string) => localePath(path, locale);
const pageUrl = `https://www.freellm.site${L('/about/')}`;

// Who stands behind the claims — the E-E-A-T signal the page already makes in prose,
// stated in a form a machine can read.
const MAINTAINER = {
  '@type': 'Person',
  '@id': 'https://www.freellm.site/#maintainer',
  name: 'Khushal Jethava',
  url: 'https://github.com/khushaljethava',
  sameAs: ['https://github.com/khushaljethava'],
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      name: ta.h1,
      description: ta.description,
      url: pageUrl,
      inLanguage: locale,
      dateModified: SITE_LAST_MODIFIED,
      mainEntity: { '@id': 'https://www.freellm.site/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.freellm.site/#organization',
      name: 'freellm.site',
      url: 'https://www.freellm.site/',
      logo: 'https://www.freellm.site/logo.png',
      founder: MAINTAINER,
      sameAs: ['https://github.com/khushaljethava/freellm-apis'],
    },
    MAINTAINER,
  ],
};
---
<Base
  locale={locale}
  altLocales={TRANSLATED_LOCALES}
  title={ta.title}
  description={ta.description}
  schema={schema}
>
  <article class="prose mx-auto max-w-3xl py-4 dark:prose-invert prose-headings:tracking-tight prose-a:text-primary">
    <h1>{ta.h1}</h1>
    <p class="lead">{ta.lead}</p>

    <h2>{ta.whatTitle}</h2>
    <p>{ta.what(providerCount, modelCount)}</p>

    <h2>{ta.sourceTitle}</h2>
    <p>{ta.sourceLead}<a href="https://github.com/khushaljethava/freellm-apis" target="_blank" rel="noopener">freellm-apis</a>{ta.sourceLeadEnd}</p>
    <ul>
      {ta.sourceItems.map(item => <li>{item}</li>)}
    </ul>
    <p>{ta.sourceNote}</p>

    <h2>{ta.whoTitle}</h2>
    <p>{ta.whoA}<a href="https://github.com/khushaljethava" target="_blank" rel="noopener">Khushal Jethava</a>{ta.whoB}</p>

    <h2>{ta.ossTitle}</h2>
    <p>{ta.ossA}<a href="https://github.com/khushaljethava/freellm-apis/issues" target="_blank" rel="noopener">{ta.ossLink}</a>{ta.ossB}</p>

    <h2>{ta.contactTitle}</h2>
    <p>{ta.contactA}<a href="/contact/">{ta.contactLink}</a>{ta.contactB}</p>
  </article>
</Base>
