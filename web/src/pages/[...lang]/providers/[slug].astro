---
import Base from '../../../layouts/Base.astro';
import providers from '../../../../../data/providers.json';
import AdSlot from '../../../components/AdSlot.astro';
import models from '../../../../../data/models.json';
import { DEFAULT_LOCALE, localePath } from '../../../i18n/config';
import { TRANSLATED_LOCALES, useTranslations } from '../../../i18n/ui';
import { postsFor, postIn, postHref } from '../../../i18n/posts';
import { isProviderIndexable } from '../../../lib/seo.mjs';
import Badge from '../../../components/ui/Badge.astro';
import { fmtCtx, CARD_VARIANT, COMPARE_PAIRS } from '../../../lib/format';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.flatMap(locale =>
    providers.map(p => ({
      params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: p.id },
      props: { provider: p, locale },
    }))
  );
}

const { provider, locale } = Astro.props;
const t = useTranslations(locale);
const tp = t.provider;
const L = (p: string) => localePath(p, locale);
// Blog links fall back to English per post, not per locale.
const G = (slug: string) => postHref(locale, slug);

const providerModels = models.filter(m => m.provider_id === provider.id && !m.deprecated);
const firstModel = providerModels[0];
// Providers we cannot yet list a single free model for are a base URL plus boilerplate.
// Keep them reachable and crawlable, keep them out of the index until the data exists.
const indexable = isProviderIndexable(provider.id);

// --- Data-driven unique overview (raises per-page content uniqueness) ---
const regionLabel = tp.region;
const maxCtx = providerModels.length ? Math.max(...providerModels.map(m => m.context_window)) : 0;
const maxRpm = providerModels.map(m => m.rpm).filter(Boolean);
const modalities = [...new Set(providerModels.flatMap(m => m.modalities))];

const freeClause = provider.free_type === 'credits' && provider.credit_amount_usd != null
  ? tp.freeCredits(provider.credit_amount_usd, provider.credit_expiry)
  : tp.freeTierPermanent;
const cardClause = tp.card[provider.credit_card_required];

const overview = [
  tp.ovIntro(provider.name, regionLabel[provider.region] ?? regionLabel.unknown, freeClause),
  providerModels.length
    ? tp.ovModels(
        providerModels.length,
        maxCtx ? fmtCtx(maxCtx) : '',
        modalities.join(', ')
      )
    : tp.ovNoModels,
  maxRpm.length ? tp.ovRpm(Math.max(...maxRpm)) : '',
  tp.ovEndpoint(cardClause, provider.base_url, provider.name),
].filter(Boolean).join(' ');

// --- Related providers (same region, else same free tier), top by model count ---
const modelCountOf = (id) => models.filter(m => m.provider_id === id && !m.deprecated).length;
const pool = providers.filter(p => p.id !== provider.id);
const sameRegion = pool.filter(p => p.region === provider.region);
const related = (sameRegion.length >= 3 ? sameRegion : pool.filter(p => p.free_type === provider.free_type))
  .sort((a, b) => modelCountOf(b.id) - modelCountOf(a.id))
  .slice(0, 4);

// Titles come from the post data for whichever language the blog exists in.
const guides = ['best-free-llm-apis-2026', 'openai-compatible-api-guide', 'best-free-llm-apis-for-coding']
  .map(slug => postIn(locale, slug) ?? postIn(DEFAULT_LOCALE, slug))
  .filter(Boolean);

// Compare pages that involve this provider.
const nameOf = (id) => providers.find(p => p.id === id)?.name ?? id;
const compareLinks = COMPARE_PAIRS
  .filter(pair => pair.includes(provider.id))
  .map(([a, b]) => ({ href: L(`/compare/${a}-vs-${b}/`), other: nameOf(a === provider.id ? b : a) }));

// provider.notes is untranslated source data. Only English may render it verbatim;
// every other locale uses the fully-translated card clause instead.
const descLead = locale === DEFAULT_LOCALE ? provider.notes : cardClause;

const cardLabel = t.common.cardLabel;

const pythonSnippet = `from openai import OpenAI

client = OpenAI(
    base_url="${provider.base_url}",
    api_key="YOUR_API_KEY",  # get at ${provider.signup_url}
)
response = client.chat.completions.create(
    model="${firstModel?.model_id ?? 'MODEL_ID'}",
    messages=[{"role": "user", "content": "Hello!"}],
)
print(response.choices[0].message.content)`;

const curlSnippet = `curl ${provider.base_url}/chat/completions \\
  -H "Authorization: Bearer YOUR_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "${firstModel?.model_id ?? 'MODEL_ID'}",
    "messages": [{"role": "user", "content": "Hello!"}]
  }'`;

const pageUrl = `https://www.freellm.site${L(`/providers/${provider.id}/`)}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: tp.home, item: `https://www.freellm.site${L('/')}` },
        { '@type': 'ListItem', position: 2, name: tp.h1(provider.name), item: pageUrl },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: tp.h1(provider.name),
      inLanguage: locale,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      url: pageUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: provider.credit_card_required === 'no'
          ? 'Free tier, no credit card required'
          : 'Free tier available',
        url: provider.signup_url,
      },
      dateModified: provider.last_verified,
      isBasedOn: provider.signup_url,
      publisher: { '@type': 'Organization', name: 'freellm.site', url: 'https://www.freellm.site/' },
    },
  ],
};
---
<Base
  locale={locale}
  altLocales={TRANSLATED_LOCALES}
  title={tp.title(provider.name)}
  description={tp.description(descLead, provider.base_url, providerModels.length)}
  schema={schema}
  noindex={!indexable}
>
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
    <ol class="flex items-center gap-1.5">
      <li><a class="text-muted-foreground hover:text-foreground" href={L('/')}>{tp.home}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-foreground">{provider.name}</li>
    </ol>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{tp.h1(provider.name)}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{overview}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href={provider.signup_url} target="_blank" rel="noopener" class="btn btn-primary">{tp.getKeyCta}</a>
        <Badge variant={CARD_VARIANT[provider.credit_card_required]}>{cardLabel[provider.credit_card_required]}</Badge>
      </div>
    </div>

    <aside class="h-fit rounded-xl border bg-card p-5 text-sm">
      <dl class="grid gap-4">
        <div>
          <dt class="mb-1.5 text-xs font-medium text-muted-foreground">{tp.baseUrlLabel}</dt>
          <dd><button type="button" id="copy-btn" class="w-full cursor-pointer truncate rounded-md border bg-muted/50 px-3 py-2 text-start font-mono text-xs hover:bg-muted" title={provider.base_url}>{provider.base_url}</button></dd>
        </div>
        <div>
          <dt class="mb-1 text-xs font-medium text-muted-foreground">{tp.cardRequiredLabel}</dt>
          <dd>{cardLabel[provider.credit_card_required]}</dd>
        </div>
        {provider.free_type === 'credits' && provider.credit_amount_usd != null && (
          <div>
            <dt class="mb-1 text-xs font-medium text-muted-foreground">{tp.freeCreditsLabel}</dt>
            <dd>${provider.credit_amount_usd} USD ({provider.credit_expiry})</dd>
          </div>
        )}
        <div>
          <dt class="mb-1 text-xs font-medium text-muted-foreground">{tp.notesLabel}</dt>
          <dd>{provider.notes}</dd>
        </div>
        <div>
          <dt class="mb-1 text-xs font-medium text-muted-foreground">{t.common.lastVerified}</dt>
          <dd>
            <time datetime={provider.last_verified}>{provider.last_verified}</time>
            {' · '}
            <a href={provider.signup_url} target="_blank" rel="noopener nofollow">{t.common.sourceLink(provider.name)}</a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <AdSlot variant="top" />

  {providerModels.length > 0 && (
    <>
      <h2 class="section-title">{tp.freeModelsTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">{t.modelsIndex.modelId}</th><th scope="col">{t.modelsIndex.context}</th><th scope="col">{t.modelsIndex.modalities}</th><th scope="col">RPM</th><th scope="col">RPD</th></tr></thead>
          <tbody>
            {providerModels.map(m => (
              <tr>
                <td><code class="font-mono text-xs">{m.model_id}</code></td>
                <td class="tabular-nums">{fmtCtx(m.context_window)}</td>
                <td><div class="flex flex-wrap gap-1">{m.modalities.map(x => <Badge>{x}</Badge>)}</div></td>
                <td class="tabular-nums">{m.rpm ?? '—'}</td>
                <td class="tabular-nums">{m.rpd ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2 class="section-title">{tp.quickStartTitle}</h2>
  <div class="grid gap-4 lg:grid-cols-2">
    <div class="snippet">
      <div class="snippet-label">Python (OpenAI SDK)</div>
      <pre><code>{pythonSnippet}</code></pre>
    </div>
    <div class="snippet">
      <div class="snippet-label">curl</div>
      <pre><code>{curlSnippet}</code></pre>
    </div>
  </div>

  {related.length > 0 && (
    <>
      <h2 class="section-title">{tp.relatedTitle}</h2>
      <ul class="link-list">
        {related.map(p => (
          <li><a href={L(`/providers/${p.id}/`)}>{tp.relatedItem(p.name, modelCountOf(p.id))}</a></li>
        ))}
      </ul>
    </>
  )}

  {compareLinks.length > 0 && (
    <>
      <h2 class="section-title">{tp.compareTitle(provider.name)}</h2>
      <ul class="link-list">
        {compareLinks.map(c => (
          <li><a href={c.href}>{tp.compareItem(provider.name, c.other)}</a></li>
        ))}
      </ul>
    </>
  )}

  <h2 class="section-title">{tp.guidesTitle}</h2>
  <ul class="link-list">
    {guides.map(g => (
      <li><a href={G(g.slug)}>{g.title}</a></li>
    ))}
  </ul>

  <AdSlot variant="bottom" />
</Base>

<script define:vars={{ baseUrl: provider.base_url, copiedLabel: tp.copied }}>
  const btn = document.getElementById('copy-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(baseUrl);
      const orig = btn.textContent;
      btn.textContent = copiedLabel;
      setTimeout(() => btn.textContent = orig, 1500);
    });
  }
</script>
