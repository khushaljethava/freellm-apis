---
import Base from '../../../layouts/Base.astro';
import providers from '../../../../../data/providers.json';
import AdSlot from '../../../components/AdSlot.astro';
import models from '../../../../../data/models.json';
import { DEFAULT_LOCALE, localePath } from '../../../i18n/config';
import { TRANSLATED_LOCALES, useTranslations } from '../../../i18n/ui';
import { postsFor } from '../../../i18n/posts';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.flatMap(locale =>
    providers.map(p => ({
      params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: p.id },
      props: { provider: p, locale },
    }))
  );
}

const { provider, locale } = Astro.props;
const t = useTranslations(locale);
const tp = t.provider;
const L = (p: string) => localePath(p, locale);
// Blog links fall back to English until that language has posts.
const G = (p: string) => localePath(p, postsFor(locale).length ? locale : DEFAULT_LOCALE);

const providerModels = models.filter(m => m.provider_id === provider.id && !m.deprecated);
const firstModel = providerModels[0];

// --- Data-driven unique overview (raises per-page content uniqueness) ---
const regionLabel = tp.region;
const maxCtx = providerModels.length ? Math.max(...providerModels.map(m => m.context_window)) : 0;
const maxRpm = providerModels.map(m => m.rpm).filter(Boolean);
const modalities = [...new Set(providerModels.flatMap(m => m.modalities))];
const fmtCtxOverview = (c) => c >= 1_000_000 ? `${Math.round(c/1_000_000)}M` : `${Math.round(c/1_000)}K`;

const freeClause = provider.free_type === 'credits' && provider.credit_amount_usd != null
  ? tp.freeCredits(provider.credit_amount_usd, provider.credit_expiry)
  : tp.freeTierPermanent;
const cardClause = tp.card[provider.credit_card_required];

const overview = [
  tp.ovIntro(provider.name, regionLabel[provider.region] ?? regionLabel.unknown, freeClause),
  providerModels.length
    ? tp.ovModels(
        providerModels.length,
        maxCtx ? fmtCtxOverview(maxCtx) : '',
        modalities.join(', ')
      )
    : tp.ovNoModels,
  maxRpm.length ? tp.ovRpm(Math.max(...maxRpm)) : '',
  tp.ovEndpoint(cardClause, provider.base_url, provider.name),
].filter(Boolean).join(' ');

// --- Related providers (same region, else same free tier), top by model count ---
const modelCountOf = (id) => models.filter(m => m.provider_id === id && !m.deprecated).length;
const pool = providers.filter(p => p.id !== provider.id);
const sameRegion = pool.filter(p => p.region === provider.region);
const related = (sameRegion.length >= 3 ? sameRegion : pool.filter(p => p.free_type === provider.free_type))
  .sort((a, b) => modelCountOf(b.id) - modelCountOf(a.id))
  .slice(0, 4);

// Titles come from the post data for whichever language the blog exists in.
const guidePool = postsFor(locale).length ? postsFor(locale) : postsFor(DEFAULT_LOCALE);
const guides = ['best-free-llm-apis-2026', 'openai-compatible-api-guide', 'best-free-llm-apis-for-coding']
  .map(slug => guidePool.find(p => p.slug === slug))
  .filter(Boolean);

// Compare pages that involve this provider (must match the curated list in compare/[pair].astro).
const COMPARE_PAIRS = [
  ['groq', 'google_gemini'], ['groq', 'cerebras'], ['groq', 'sambanova'],
  ['cerebras', 'sambanova'], ['mistral', 'groq'], ['google_gemini', 'mistral'],
  ['github_models', 'groq'], ['together_ai', 'groq'], ['openrouter', 'groq'],
  ['cohere', 'mistral'],
];
const nameOf = (id) => providers.find(p => p.id === id)?.name ?? id;
const compareLinks = COMPARE_PAIRS
  .filter(pair => pair.includes(provider.id))
  .map(([a, b]) => ({ href: L(`/compare/${a}-vs-${b}/`), other: nameOf(a === provider.id ? b : a) }));

const cardLabel = { no: '✅ No', registration: '📧 Email', phone: '📱 Phone', yes: '💳 Yes' };

const fmtCtx = (c) => c >= 1_000_000 ? `${Math.round(c/1_000_000)}M` : `${Math.round(c/1_000)}K`;

const pythonSnippet = `from openai import OpenAI

client = OpenAI(
    base_url="${provider.base_url}",
    api_key="YOUR_API_KEY",  # get at ${provider.signup_url}
)
response = client.chat.completions.create(
    model="${firstModel?.model_id ?? 'MODEL_ID'}",
    messages=[{"role": "user", "content": "Hello!"}],
)
print(response.choices[0].message.content)`;

const curlSnippet = `curl ${provider.base_url}/chat/completions \\
  -H "Authorization: Bearer YOUR_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "${firstModel?.model_id ?? 'MODEL_ID'}",
    "messages": [{"role": "user", "content": "Hello!"}]
  }'`;

const pageUrl = `https://www.freellm.site${L(`/providers/${provider.id}/`)}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: tp.home, item: `https://www.freellm.site${L('/')}` },
        { '@type': 'ListItem', position: 2, name: tp.h1(provider.name), item: pageUrl },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: tp.h1(provider.name),
      inLanguage: locale,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      url: pageUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: provider.credit_card_required === 'no'
          ? 'Free tier, no credit card required'
          : 'Free tier available',
      },
    },
  ],
};
---
<Base
  locale={locale}
  altLocales={TRANSLATED_LOCALES}
  title={tp.title(provider.name)}
  description={tp.description(provider.notes, provider.base_url, providerModels.length)}
  schema={schema}
>
  <div class="breadcrumb">
    <a href={L('/')}>{tp.home}</a><span>›</span><span>{provider.name}</span>
  </div>

  <h1 style="font-size:1.8rem;font-weight:800;margin-bottom:1rem">{tp.h1(provider.name)}</h1>

  <p class="provider-overview" style="color:#374151;line-height:1.6;margin-bottom:1.25rem">{overview}</p>

  <div class="provider-meta">
    <div class="row">
      <span class="label">{tp.baseUrlLabel}</span>
      <button class="copy-url" id="copy-btn">{provider.base_url}</button>
    </div>
    <div class="row"><span class="label">{tp.cardRequiredLabel}</span><span>{cardLabel[provider.credit_card_required]}</span></div>
    {provider.free_type === 'credits' && provider.credit_amount_usd != null && (
      <div class="row"><span class="label">{tp.freeCreditsLabel}</span><span>${provider.credit_amount_usd} USD ({provider.credit_expiry})</span></div>
    )}
    <div class="row"><span class="label">{tp.notesLabel}</span><span>{provider.notes}</span></div>
    <div class="row"><span class="label">{t.common.lastVerified}</span><span>{provider.last_verified}</span></div>
    <div class="row">
      <a href={provider.signup_url} target="_blank" rel="noopener"
         style="background:#0066cc;color:#fff;padding:0.5rem 1.25rem;border-radius:6px;font-weight:600;font-size:0.9rem;display:inline-block">
        {tp.getKeyCta}
      </a>
    </div>
  </div>

  <AdSlot variant="top" />

  {providerModels.length > 0 && (
    <>
      <h2 class="section-title">{tp.freeModelsTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{t.modelsIndex.modelId}</th><th>{t.modelsIndex.context}</th><th>{t.modelsIndex.modalities}</th><th>RPM</th><th>RPD</th></tr></thead>
          <tbody>
            {providerModels.map(m => (
              <tr>
                <td><code>{m.model_id}</code></td>
                <td>{fmtCtx(m.context_window)}</td>
                <td>{m.modalities.join(', ')}</td>
                <td>{m.rpm ?? '—'}</td>
                <td>{m.rpd ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2 class="section-title">{tp.quickStartTitle}</h2>
  <div class="snippets">
    <div class="snippet-block">
      <div class="snippet-label">Python (OpenAI SDK)</div>
      <pre>{pythonSnippet}</pre>
    </div>
    <div class="snippet-block">
      <div class="snippet-label">curl</div>
      <pre>{curlSnippet}</pre>
    </div>
  </div>

  {related.length > 0 && (
    <>
      <h2 class="section-title">{tp.relatedTitle}</h2>
      <ul class="related-links">
        {related.map(p => (
          <li><a href={L(`/providers/${p.id}/`)}>{tp.relatedItem(p.name, modelCountOf(p.id))}</a></li>
        ))}
      </ul>
    </>
  )}

  {compareLinks.length > 0 && (
    <>
      <h2 class="section-title">{tp.compareTitle(provider.name)}</h2>
      <ul class="related-links">
        {compareLinks.map(c => (
          <li><a href={c.href}>{tp.compareItem(provider.name, c.other)}</a></li>
        ))}
      </ul>
    </>
  )}

  <h2 class="section-title">{tp.guidesTitle}</h2>
  <ul class="related-links">
    {guides.map(g => (
      <li><a href={G(`/blog/${g.slug}/`)}>{g.title}</a></li>
    ))}
  </ul>

  <AdSlot variant="bottom" />
</Base>

<script define:vars={{ baseUrl: provider.base_url, copiedLabel: tp.copied }}>
  const btn = document.getElementById('copy-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(baseUrl);
      const orig = btn.textContent;
      btn.textContent = copiedLabel;
      setTimeout(() => btn.textContent = orig, 1500);
    });
  }
</script>
