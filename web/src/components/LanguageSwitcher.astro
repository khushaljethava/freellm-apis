---
import { LOCALES, localePath, stripLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Locales this page exists in — the switcher must never link to a page that 404s. */
  available: Locale[];
}
const { locale, available } = Astro.props;
const t = useTranslations(locale);

// The same page in another language, e.g. /es/blog/ -> /de/blog/
const basePath = stripLocale(Astro.url.pathname);
---
{available.length > 1 && (
  <!-- ponytail: <details> instead of a JS dropdown — works without JS, links stay crawlable -->
  <details class="relative text-sm">
    <summary aria-label={t.nav.language} class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-md border px-3 whitespace-nowrap hover:bg-accent [&::-webkit-details-marker]:hidden">
      <svg aria-hidden="true" class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
      {LOCALES[locale].name}
    </summary>
    <ul class="absolute end-0 top-11 z-50 m-0 min-w-40 list-none rounded-lg border bg-popover p-1 shadow-lg">
      {available.map(code => (
        <li>
          <a
            href={localePath(basePath, code)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
            class="block rounded-md px-3 py-1.5 text-popover-foreground no-underline hover:bg-accent hover:no-underline aria-[current=true]:font-semibold aria-[current=true]:text-primary"
          >{LOCALES[code].name}</a>
        </li>
      ))}
    </ul>
  </details>
)}
