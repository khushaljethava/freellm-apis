---
interface Props {
  slot?: string;
  variant?: 'top' | 'bottom';
}
const { slot, variant = 'top' } = Astro.props;
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-XXXXXXXXXX';
const envSlot = variant === 'bottom'
  ? import.meta.env.PUBLIC_ADSENSE_SLOT_2
  : import.meta.env.PUBLIC_ADSENSE_SLOT_1;
const adSlot = slot || envSlot || import.meta.env.PUBLIC_ADSENSE_SLOT || '';
const isPlaceholderId = !adsenseId || adsenseId === 'ca-pub-XXXXXXXXXX';
const isLive = !isPlaceholderId && adSlot && adSlot !== 'XXXXXXXXXX';
---
{isLive ? (
  <div class="my-8 min-h-[90px]">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={adsenseId}
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
) : (
  <aside class="my-8" aria-label="Sponsored">
    <a class="group flex min-h-[90px] items-center justify-between gap-4 rounded-xl border bg-gradient-to-br from-accent to-card p-4 text-foreground no-underline transition-colors hover:border-primary/40 hover:no-underline sm:px-6" href="https://solopreneurshub.com/" target="_blank" rel="noopener sponsored">
      <div class="min-w-0">
        <p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">Sponsored</p>
        <p class="font-semibold">Find better AI tools faster</p>
        <p class="text-sm text-muted-foreground">Submit your AI tool &amp; reach thousands of builders</p>
      </div>
      <span class="btn btn-primary shrink-0">Get started →</span>
    </a>
  </aside>
)}

{isLive && (
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}
